# Open Food Facts exige identificar tu app con un User-Agent.
# Formato recomendado: NombreApp/Version (correo-de-contacto)
OFF_USER_AGENT="Sumi/0.1 (contacto@sumi.pe)"

# --- Supabase (base propia: cache de productos + aportes de la comunidad) ---
NEXT_PUBLIC_SUPABASE_URL=""
# Usa la clave publishable (recomendada) o la anon legacy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- IA para leer tablas nutricionales desde fotos (flujo foto + IA) ---
ANTHROPIC_API_KEY=""
