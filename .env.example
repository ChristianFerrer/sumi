# Open Food Facts exige identificar tu app con un User-Agent.
# Formato recomendado: NombreApp/Version (correo-de-contacto)
OFF_USER_AGENT="Sumi/0.1 (contacto@sumi.pe)"

# --- Supabase (base propia: cache de productos + aportes de la comunidad) ---
NEXT_PUBLIC_SUPABASE_URL=""
# Usa la clave publishable (recomendada) o la anon legacy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Clave service-role (SOLO servidor: cron de importacion / scripts). NUNCA la
# expongas en el cliente ni la prefijes con NEXT_PUBLIC. Opcional: si no esta,
# la importacion usa la anon key (la tabla products permite insert/update).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Importacion masiva desde Open Food Facts ---
# Protege el endpoint /api/cron/import-off. Vercel Cron lo envia como
# `Authorization: Bearer <CRON_SECRET>`. Si queda vacio, el endpoint no exige auth.
CRON_SECRET=""

# --- IA para leer tablas nutricionales desde fotos (flujo foto + IA) ---
ANTHROPIC_API_KEY=""
